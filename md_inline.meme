# md_inline.meme - Inline Markdown Parser and HTML Escaper

record LinkMatch:
    found: Bool
    split_pos: Int
    end_pos: Int

function escape_html(s: String) -> String:
    define s1 as replace "&" with "&amp;" in s
    define s2 as replace "<" with "&lt;" in s1
    define s3 as replace ">" with "&gt;" in s2
    return s3

function find_closing_backtick(s: String, start_pos: Int) -> Int:
    define len as length of string s
    if start_pos >= len:
        return -1
    for k from start_pos to len - 1:
        if char at k of s == "`":
            return k
    return -1

function find_closing_triple_star(s: String, start_pos: Int) -> Int:
    define len as length of string s
    if start_pos + 2 >= len:
        return -1
    for k from start_pos to len - 3:
        if slice s from k to k + 3 == "***":
            return k
    return -1

function find_closing_double_star(s: String, start_pos: Int) -> Int:
    define len as length of string s
    if start_pos + 1 >= len:
        return -1
    for k from start_pos to len - 2:
        if slice s from k to k + 2 == "**":
            return k
    return -1

function find_closing_single_star(s: String, start_pos: Int) -> Int:
    define len as length of string s
    if start_pos >= len:
        return -1
    for k from start_pos to len - 1:
        if char at k of s == "*":
            define is_double as false
            if k > 0:
                if char at (k - 1) of s == "*":
                    set is_double to true
            if k + 1 < len:
                if char at (k + 1) of s == "*":
                    set is_double to true
            if not is_double:
                return k
    return -1

function find_link(s: String, start_pos: Int) -> LinkMatch:
    define len as length of string s
    if start_pos + 4 > len:
        return LinkMatch(found=false, split_pos=-1, end_pos=-1)
    for k from start_pos + 1 to len - 3:
        if slice s from k to k + 2 == "](":
            for m from k + 2 to len - 1:
                if char at m of s == ")":
                    return LinkMatch(found=true, split_pos=k, end_pos=m)
    return LinkMatch(found=false, split_pos=-1, end_pos=-1)

function render_inline_escaped(s: String) -> String:
    define len as length of string s
    define out as ""
    define i as 0
    while i < len:
        define ch as char at i of s
        if ch == "`":
            define close_idx as find_closing_backtick(s, i + 1)
            if close_idx != -1:
                define inner as slice s from i + 1 to close_idx
                set out to out + "<code>" + inner + "</code>"
                set i to close_idx + 1
            else:
                set out to out + "`"
                set i to i + 1
        else if ch == "[":
            define lm as find_link(s, i)
            if lm.found:
                define link_text as slice s from i + 1 to lm.split_pos
                define link_url as slice s from lm.split_pos + 2 to lm.end_pos
                define rendered_text as render_inline_escaped(link_text)
                set out to out + "<a href=\"" + link_url + "\">" + rendered_text + "</a>"
                set i to lm.end_pos + 1
            else:
                set out to out + "["
                set i to i + 1
        else if i + 2 < len and slice s from i to i + 3 == "***":
            define close_idx as find_closing_triple_star(s, i + 3)
            if close_idx != -1:
                define inner as slice s from i + 3 to close_idx
                define rendered_inner as render_inline_escaped(inner)
                set out to out + "<strong><em>" + rendered_inner + "</em></strong>"
                set i to close_idx + 3
            else:
                set out to out + "***"
                set i to i + 3
        else if i + 1 < len and slice s from i to i + 2 == "**":
            define close_idx as find_closing_double_star(s, i + 2)
            if close_idx != -1:
                define inner as slice s from i + 2 to close_idx
                define rendered_inner as render_inline_escaped(inner)
                set out to out + "<strong>" + rendered_inner + "</strong>"
                set i to close_idx + 2
            else:
                set out to out + "**"
                set i to i + 2
        else if ch == "*":
            define close_idx as find_closing_single_star(s, i + 1)
            if close_idx != -1:
                define inner as slice s from i + 1 to close_idx
                define rendered_inner as render_inline_escaped(inner)
                set out to out + "<em>" + rendered_inner + "</em>"
                set i to close_idx + 1
            else:
                set out to out + "*"
                set i to i + 1
        else:
            set out to out + ch
            set i to i + 1
    return out

function render_inline(raw_text: String) -> String:
    define escaped as escape_html(raw_text)
    return render_inline_escaped(escaped)
